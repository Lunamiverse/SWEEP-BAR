#include <winver.h>
#include "resource.h"

IDI_APPICON ICON "sweepbar.ico"
1 24 "installer.manifest"

IDR_PLUGIN RCDATA "../build/win/Sweepbar.vst3/Contents/x86_64-win/Sweepbar.vst3"
IDR_README RCDATA "../build/installer/README.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    SWEEPBAR_VERSION_NUM
PRODUCTVERSION SWEEPBAR_VERSION_NUM
FILEOS         0x40004
FILETYPE       0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Sweepbar"
      VALUE "FileDescription",  "Sweepbar Setup"
      VALUE "FileVersion",      SWEEPBAR_VERSION_STR
      VALUE "ProductName",      "Sweepbar"
      VALUE "ProductVersion",   SWEEPBAR_VERSION_STR
      VALUE "OriginalFilename", "SweepbarSetup.exe"
      VALUE "LegalCopyright",   "Sweepbar"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
